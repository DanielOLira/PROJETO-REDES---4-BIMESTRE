#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
	int estado[10];
	int i;
	int n;
	int ativos = 0;
	int inativos = 0;

	printf("radar de despositivos da rede\n");

	do {
		printf("quantidade de dispositivos (1 a 10): ");
		if (scanf("%d", &n) != 1) {
			n = 0;   
		}
		fflush(stdin);   

		if (n < 1 || n > 10) {
			printf("valor invalido, digite um numero de dispositivos de 1 a 10\n");
		}
	} while (n < 1 || n > 10);

	for (i = 0; i < n; i++) {
		do {
			printf("estado do dispositivo %d (1 - ativo, 0 - inativo): ", i + 1);
			if (scanf("%d", &estado[i]) != 1) {
				estado[i] = -1;   
			}
			fflush(stdin);   

			if (estado[i] != 0 && estado[i] != 1) {
				printf("valor invalido, digite apenas 1 ou 0.\n");
			}
		} while (estado[i] != 0 && estado[i] != 1);
	}

	printf("\n PAINEL \n");
	for (i = 0; i < n; i++) {
		printf("dispositivo %d: ", i + 1);
		if (estado[i] == 1) {
			printf("ativo\n");
			ativos = ativos + 1;
		} else {
			printf("inativo\n");
			inativos = inativos + 1;
		}
	}

	double percentual = ativos * 100.0 / n;

	printf("\n");
	printf("ativos: %d\n", ativos);
	printf("inativos: %d\n", inativos);
	printf("disponibilidade: %.1f%%\n", percentual);

	if (inativos >= 2) {
		printf("alerta: %d dispositivos indisponiveis\n", inativos);
	} else {
		printf("situacao normal \n");
	}

	return 0;
}
